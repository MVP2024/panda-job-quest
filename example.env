# Приватные ключи для HeadHunter API
HH_CLIENT_ID=ваш_client_id
HH_CLIENT_SECRET=ваш_client_secret

# Базовый URL для API HeadHunter
HH_API_BASE_URL=https://api.hh.ru/vacancies

# User-Agent для запросов к API
HH_USER_AGENT=PandaJobQuest/1.0

# Параметры по умолчанию для поиска вакансий
HH_DEFAULT_AREA=1 # Россия
HH_DEFAULT_PER_PAGE=50

# Путь к файлу для хранения вакансий
VACANCIES_STORAGE_PATH=data/vacancies.json

# Опциональные настройки логирования
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
